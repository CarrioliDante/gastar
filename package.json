{
  "name": "gastar",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "dev:web": "pnpm --filter @gastar/web dev",
    "dev:landing": "pnpm --filter @gastar/landing dev",
    "dev:mobile": "pnpm --filter @gastar/mobile start",
    "build:web": "pnpm --filter @gastar/web build",
    "build:landing": "pnpm --filter @gastar/landing build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "clean": "rm -rf apps/web/.next apps/landing/.next"
  },
  "devDependencies": {
    "playwright": "^1.60.0",
    "typescript": "^5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@prisma/engines",
      "prisma",
      "sharp",
      "unrs-resolver"
    ]
  }
}
